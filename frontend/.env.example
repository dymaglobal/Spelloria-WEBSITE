# Spelloria Patisserie Frontend Environment Configuration

# Node Environment
NODE_ENV=production

# Base Public URL
NEXT_PUBLIC_SITE_URL=https://spelloria.com

# Backend API Endpoint (Optional if using built-in Next.js internal API engine)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Authentication & Session Security (Must be random 64-char string in production)
AUTH_SECRET=spelloria_production_jwt_session_secret_token_replace_with_hex_64_chars

# Currency Configuration (Default: INR for Indian Market)
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_CODE=INR
