# Environment & Server
ENVIRONMENT=development
PROJECT_NAME="Spelloria Patisserie API"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_super_secret_64_character_hex_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL Async)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=spelloria_user
POSTGRES_PASSWORD=spelloria_secure_password_2026
POSTGRES_DB=spelloria_db
DATABASE_URL=postgresql+asyncpg://spelloria_user:spelloria_secure_password_2026@localhost:5432/spelloria_db

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./static/uploads

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://spelloria.com"]

# Super Admin Initial Seed
FIRST_SUPERUSER_EMAIL=admin@spelloria.com
FIRST_SUPERUSER_PASSWORD=SpelloriaAdmin2026!
FIRST_SUPERUSER_FULLNAME="Ameen Rahman"
