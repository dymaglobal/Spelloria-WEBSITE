# ==============================================================================
# SPELLORIA PATISSERIE — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ("production" or "development")
NODE_ENV=production

# Base Public Website URL
NEXT_PUBLIC_SITE_URL=https://spelloria.com

# Administrator Session Secret (Replace with random 64-character hex string)
AUTH_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production

# Currency Configuration (Default: INR / ₹ for Indian Market)
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_CODE=INR

# HTTP Port (Hostinger Cloud Startup will inject PORT dynamically or default 3000)
PORT=3000

# Database & Media Paths (Optional overrides - defaults resolve automatically)
# DB_FILE_PATH=./frontend/data/db.json
# UPLOADS_DIR=./frontend/public/images/uploads
